<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>3D Multiplayer Shooter</title>
    <style>
        body { margin: 0; overflow: hidden; font-family: 'Segoe UI', sans-serif; }
        #game-container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
        
        /* UI Layers */
        #ui-layer { position: absolute; width: 100%; height: 100%; pointer-events: none; }
        
        /* Lobby */
        #lobby-screen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(20, 20, 30, 0.95);
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            pointer-events: auto; color: white; z-index: 10;
        }
        
        /* HUD */
        #hud { display: none; position: absolute; bottom: 20px; left: 20px; color: white; pointer-events: auto; z-index: 5; }
        .bar-container { width: 200px; height: 20px; background: #333; margin-top: 5px; border-radius: 4px; overflow: hidden; }
        #health-bar { height: 100%; background: #e74c3c; width: 100%; transition: width 0.2s; }
        #death-screen { display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(100,0,0,0.3); align-items: center; justify-content: center; color: white; font-size: 40px; font-weight: bold; z-index: 8; }

        /* Inputs */
        input, select, button { padding: 10px; margin: 5px; font-size: 16px; border-radius: 5px; border: none; pointer-events: auto; }
        button { background: #007bff; color: white; cursor: pointer; }
        button:hover { background: #0056b3; }
    </style>
</head>
<body>
    <div id="game-container"></div>

    <div id="ui-layer">
        <div id="hud">
            <div id="ammo-display">Ammo: 20</div>
            <div class="bar-container"><div id="health-bar"></div></div>
            <button id="logout-btn" style="margin-top:10px; background:#444;">Logout</button>
        </div>
        <div id="death-screen">RESPAWNING...</div>
        
        <!-- Lobby -->
        <div id="lobby-screen">
            <h1>Neon Shooter 3D</h1>
            <div id="auth-form">
                <input type="text" id="username" placeholder="Username" value="Player 1">
                <br>
                <select id="team-select">
                    <option value="#3498db">Blue Team</option>
                    <option value="#e74c3c">Red Team</option>
                    <option value="#2ecc71">Green Team</option>
                </select>
                <br>
                <button id="join-btn">Join Game</button>
            </div>
            <p id="status-msg" style="color: yellow; margin-top: 10px;"></p>
        </div>
    </div>

    <!-- External Libs -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    
    <!-- Main Client Script -->
    <!-- Removed 'type=module' to prevent strict MIME issues in some browsers -->
    <script src="client.js"></script>
</body>
</html>